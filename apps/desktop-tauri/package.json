{
  "name": "hermix-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev": "node scripts/dev.mjs dev",
    "build:vite": "vite build",
    "_:build-shell": "cargo build --release --manifest-path ../hx-shell/Cargo.toml --target-dir ..\\..\\release\\target",
    "_:sync-shell": "copy /y ..\\..\\release\\target\\release\\hx-shell.exe src-tauri\\resources\\loader\\hx-shell.exe",
    "_:sync-shell-runtime": "if not exist \"%USERPROFILE%\\.hermix\\loader\" mkdir \"%USERPROFILE%\\.hermix\\loader\" && copy /y ..\\..\\release\\target\\release\\hx-shell.exe \"%USERPROFILE%\\.hermix\\loader\\hx-shell.exe\"",
    "build": "node scripts/dev.mjs build",
    "check:tokens": "node ../../scripts/check-theme-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ensure-sidecar": "node scripts/ensure-sidecar.mjs"
  },
  "dependencies": {
    "@bruits/satteri-wasm32-wasi": "0.10.5",
    "@hermix/preview": "workspace:*",
    "@lobehub/icons": "^5.10.0",
    "@panzoom/panzoom": "^4.6.2",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "echarts": "^6.1.0",
    "exceljs": "4.4.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^0.511.0",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.3.289",
    "pinyin-pro": "^3.29.5",
    "pptx-browser": "^4.1.5",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.2.4",
    "refractor": "^3.6.0",
    "satteri": "^0.10.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.1"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}