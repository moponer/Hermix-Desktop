{
  "name": "hermix-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:backend": "cargo build -p hermix-server --target-dir ..\\..\\release\\target",
    "dev": "node scripts/dev.mjs dev",
    "build:vite": "vite build",
    "build:backend": "cargo build -p hermix-server --release --target-dir ..\\..\\release\\target",
    "_:build-shell": "cargo build --release --manifest-path ../hx-shell/Cargo.toml --target-dir ..\\..\\release\\target",
    "_:ensure-sidecar": "copy /y ..\\..\\release\\target\\release\\hermix.exe src-tauri\\binaries\\hermix-x86_64-pc-windows-msvc.exe",
    "_:sync-shell": "copy /y ..\\..\\release\\target\\release\\hx-shell.exe src-tauri\\resources\\loader\\hx-shell.exe",
    "_:sync-shell-runtime": "if not exist \"%USERPROFILE%\\.hermix\\loader\" mkdir \"%USERPROFILE%\\.hermix\\loader\" && copy /y ..\\..\\release\\target\\release\\hx-shell.exe \"%USERPROFILE%\\.hermix\\loader\\hx-shell.exe\"",
    "build": "node scripts/dev.mjs build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lobehub/icons": "^5.10.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "clsx": "^2.1.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^0.511.0",
    "papaparse": "^5.5.4",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "refractor": "^3.6.0",
    "remark-breaks": "3.0.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.1"
  }
}
