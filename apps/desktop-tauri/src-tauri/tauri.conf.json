{
  "productName": "Hermix Desktop",
  "version": "0.1.14",
  "identifier": "com.hermix.desktop",
  "build": {
    "frontendDist": "../../../release/frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run ensure-sidecar && npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hermix Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "incognito": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msSmartScreenProtection,EdgeFeed,CalculateNativeWinOcclusion,IntensiveWakeUpThrottling,RendererCodeIntegrity --disable-renderer-backgrounding --disable-background-timer-throttling --disk-cache-size=20971520 --js-flags=--max-old-space-size=1024",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; img-src 'self' data: https: blob: asset: http://asset.localhost; frame-src 'self' asset: file: http://asset.localhost; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.hermix/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/hermix",
      "binaries/officecli",
      "binaries/markitdown",
      "binaries/usn-indexer",
      "binaries/hermix-viewer"
    ],
    "publisher": "Hermix",
    "shortDescription": "Hermix Desktop portable AI agent (Windows)",
    "longDescription": "A fully portable AI agent desktop app. All user data lives next to the executable, no system-wide writes, no C drive bloat. Zip, copy, run.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/skills/modelscope-dev/frontend-dev/SKILL.md",
      "resources/skills/modelscope-dev/fullstack-dev/SKILL.md",
      "resources/skills/modelscope-dev/android-native-dev/SKILL.md",
      "resources/skills/modelscope-dev/ios-application-dev/SKILL.md",
      "resources/loader/hx-shell.exe",
      "resources/loader/WebView2Loader.dll",
      "resources/loader/esbuild.exe",
      "resources/loader/react/react.production.min.js",
      "resources/loader/react/react-dom.production.min.js"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}