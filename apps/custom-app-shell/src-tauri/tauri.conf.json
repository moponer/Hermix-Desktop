{
  "productName": "Custom App Shell",
  "version": "1.0.0",
  "identifier": "com.hermix.custom-app-shell",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "自定义应用",
        "width": 600,
        "height": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https: blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:;"
    }
  },
  "bundle": {
    "active": false
  }
}
