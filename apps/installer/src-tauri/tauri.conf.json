{
  "productName": "Hermix Setup",
  "version": "0.1.0",
  "identifier": "com.hermix.installer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hermix 安装程序",
        "width": 560,
        "height": 480,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
