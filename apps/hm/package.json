{
  "name": "hermix-m",
  "version": "0.1.0",
  "private": true,
  "description": "Hermix M — hermix 的手机伴侣端。薄客户端：agent 引擎在 PC，手机只做入口、审批与呈现。",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
