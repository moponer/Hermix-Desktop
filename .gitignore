# Tauri .cargo (only config.toml is source)
apps/desktop-tauri/src-tauri/.cargo/*
!apps/desktop-tauri/src-tauri/.cargo/config.toml

# Release directory (build outputs)
/release/**
!/release/.gitkeep
!/release/build.sh

# Staging directories (cargo/npm artifacts)
**/*-staging/

