# Agent runtime
.mimocode/
.workbuddy/
/.workbuddy-*

# Build outputs
apps/desktop-tauri/src-tauri/gen/
apps/desktop-tauri/src-tauri/target/
apps/desktop-tauri/dist/

# 临时构建产物目录 (某次 CARGO_TARGET_DIR=_hxbuild 构建遗留, 全部 .rlib/.rmeta)
_hxbuild/

# Sidecar binaries（构建产物，一律不提交；源码在 crates/ 与 apps/ 下，
# 由 apps/desktop-tauri/scripts/ensure-sidecar.mjs 在打包前刷进 binaries/）
apps/desktop-tauri/src-tauri/binaries/*

# Release directory (build outputs)
/release/**
# 散落到 apps/ 下的 release 是错误位置（统一产物在仓库根 /release/target）
apps/release/

# Staging directories (cargo/npm artifacts)
**/*-staging/

# 验证草稿巨目录（cargo/前端校验产物，绝不可提交）
_verify*/
target_verify*/
target_gw_test/
target_check_agent/

# 本地 npm 配置（可能含凭证，不随源码提交）
apps/desktop-tauri/.npmrc

# Dev-mode data (runtime artifacts, not source)
hermix-data/
hermix-data-*/
hermix-stderr.log
hermix-stdout.log
backend_stderr.txt
backend_stdout.txt
# 只忽略仓库根的运行时 data/ (gitignore 无锚定会误伤 src/**/data/ 源码目录)
/data/
cache/
logs/
webview-cache/
.hermix-data/

# Windows build artifacts
apps/desktop-tauri/%BIN_DIR%/
apps/desktop-tauri/src-tauri/$null

# Release zip
/HermixDesktop.zip

# Tooling preview configs (regenerated by port-forwarding / preview tool)
.catpaw/

# Ad-hoc debug scripts / query files dropped at repo root
/check_api.mjs
/query_db.sql
/tmp_msgs.json
_count_lines.ps1

# Root-level temp files (cargo check output, test output, debug scripts)
/*.txt
/*.py
/*.bat

# tsc / typecheck temp logs dropped during runs
**/tmp_tsc*.txt
**/tsc_check.txt
**/tsc_err*.txt
**/tsc_light_check.txt
**/tsc_output*.txt

# Tauri sidecar binaries (build outputs, NOT source — never commit)
apps/desktop-tauri/src-tauri/binaries/

# Editor / merge backup artifacts (never commit)
*.orig
*.original

# Agent-run work outputs (local only, never committed)
/outputs/

# 手工安装的 npm tarball / 解包目录。pnpm 会跳过 wasm32 的 optionalDependencies，
# satteri 的浏览器侧 wasm 栈必须手工拉包，过程中留下这些中间产物。
satteri-win32.tgz
apps/desktop-tauri/_sat_pkg/
apps/desktop-tauri/satteri_verify.mjs

# 工具运行期的临时草稿（python 解包脚本留下的空文件等）
# 不带尾斜杠：这些残留实测是**文件**不是目录，`_tmp_*/` 匹配不到
apps/desktop-tauri/_tmp_*

# 其他 IDE / agent 工具的本地状态目录
.atomcode/
.zcode/
/windows_cmd_analysis.md
.tmp-probe/

# 临时工作产物（一次性脚本草稿 / 设计预览稿，保留在本地不入库）
apps/desktop-tauri/src-tauri/.scratch/
# 两个目录名都真实存在（design-previews/ 是较早的 splash 设计稿，
# design-preview/ 是后来建的），一条通配一并覆盖
/design-preview*/

# IM channel credentials — do NOT commit (plaintext bot secret)
im_channels.json
hermix_home/im_channels.json

# git worktree 检出目录（本地开发态，不入库）
.worktrees/

# Python 字节码缓存（verify-stability-suite 等本机运行产物）
__pycache__/
*.pyc

# html5ever vendor 修复的中间产物（只入库 -patched 副本，见 Cargo.toml [patch.crates-io]）
patches/html5ever-0.39.0/
patches/html5ever-0.39.0.crate
